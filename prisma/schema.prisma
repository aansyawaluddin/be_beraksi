generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum JenisKelamin {
  LAKI_LAKI
  PEREMPUAN
}

enum JenisPengusulan {
  DIRI_SENDIRI
  ORANG_LAIN
}

enum JenisUsulan {
  INDIVIDU
  KELUARGA
}

enum StatusPengusulan {
  MENUNGGU_REVIEW
  DISETUJUI
  DITOLAK
}

model User {
  id        Int   @id @default(autoincrement())
  nama      String
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wargaDiinput Warga[]

  @@map("users")
}

model Warga {
  id                        Int           @id @default(autoincrement())
  provinsi                  String?
  kabupaten                 String
  kecamatan                 String
  desaKelurahan             String
  alamat                    String?       @db.Text
  dusun                     String?
  rw                        String?
  rt                        String?
  desilTerbaru              String?
  nomorKK                   String
  nik                       String        @unique
  nama                      String
  jenisKelamin              JenisKelamin?
  tanggalLahir              DateTime?
  umur                      Int?
  statusPerkawinan          String?
  hubunganKeluarga          String?
  lanjutUsia                String?
  disabilitas               String?
  keteranganDisabilitas     String?

  createdById               Int?
  createdBy                 User?         @relation(fields: [createdById], references: [id])
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  @@index([kabupaten])
  @@index([kecamatan])
  @@index([desilTerbaru])
  @@map("warga")
}

model Pengusulan {
  id                Int           @id @default(autoincrement())
  jenisPengusulan   JenisPengusulan
  jenisUsulan       JenisUsulan

  namaPengusul      String
  nikPengusul       String

  namaCalonPenerima String
  nikCalonPenerima  String

  programSlug       String

  kabupaten         String
  nomorWhatsapp     String
  keterangan        String?          @db.Text

  fotoKtp           String
  fotoKk            String
  fotoRumah         String

  status            StatusPengusulan @default(MENUNGGU_REVIEW)
  catatanAdmin      String?          @db.Text
  diprosesAt        DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([nikCalonPenerima])
  @@index([status])
  @@index([programSlug])
  @@map("pengusulan")
}

