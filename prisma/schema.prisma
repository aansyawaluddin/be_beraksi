generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum JenisKelamin {
  LAKI_LAKI
  PEREMPUAN
}

enum JenisPengusulan {
  DIRI_SENDIRI
  ORANG_LAIN
}

enum JenisUsulan {
  INDIVIDU
  KELUARGA
}

enum StatusPengusulan {
  MENUNGGU_REVIEW
  DISETUJUI
  DITOLAK
}

model User {
  id        String   @id @default(uuid())
  nama      String
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wargaDiinput Warga[]

  @@map("users")
}

model Warga {
  id                        String        @id @default(uuid())
  kabupaten                 String
  kecamatan                 String
  desaKelurahan             String
  alamat                    String?       @db.Text
  rw                        String?
  rt                        String?
  desilTerbaru              String?
  nomorKK                   String
  nik                       String        @unique
  nama                      String
  jenisKelamin              JenisKelamin?
  tanggalLahir              DateTime?
  tempatLahir               String?
  statusPerkawinan          String?
  hubunganKeluarga          String?
  keberadaanAnggotaKeluarga String?
  disabilitas               String?
  keteranganDisabilitas     String?
  pbiJk                     String?
  bansosPkh                 String?
  bansosSembako             String?

  createdById               String?
  createdBy                 User?         @relation(fields: [createdById], references: [id])
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  @@index([kabupaten])
  @@index([kecamatan])
  @@index([desilTerbaru])
  @@map("warga")
}

model ProgramBantuan {
  id        String   @id @default(uuid())
  nama      String   @unique
  aktif     Boolean  @default(true)
  urutan    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pengusulan Pengusulan[]

  @@map("program_bantuan")
}

model Pengusulan {
  id                String           @id @default(uuid())
  jenisPengusulan   JenisPengusulan
  jenisUsulan       JenisUsulan

  namaPengusul      String
  nikPengusul       String

  namaCalonPenerima String
  nikCalonPenerima  String

  programId         String
  program           ProgramBantuan   @relation(fields: [programId], references: [id])

  kabupaten         String
  nomorWhatsapp     String
  keterangan        String?          @db.Text

  fotoKtp           String
  fotoKk            String
  fotoRumah         String

  status            StatusPengusulan @default(MENUNGGU_REVIEW)
  catatanAdmin      String?          @db.Text
  diprosesAt        DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([nikCalonPenerima])
  @@index([status])
  @@index([programId])
  @@map("pengusulan")
}